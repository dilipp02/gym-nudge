{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gym-nudge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Nudge scheduler (spec §8.1): every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-nudge",
      // Replaced with the real ID from `wrangler d1 create gym-nudge` at deploy time (plan 5.1).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
  // Passkey relying party. Production values are set at deploy time (plan 5.1).
  // Secrets (SESSION_SECRET, VAPID_*, REGISTRATION_TOKEN) live in .dev.vars locally
  // and `wrangler secret put` in production.
  "vars": {
    "RP_ID": "localhost",
    "RP_NAME": "Gym Nudge",
    "APP_ORIGIN": "http://localhost:5180",
  },
}
